<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Per-link Gazebo properties (values from the original arm.gazebo). -->
  <xacro:macro name="gz_link_properties" params="name">
    <gazebo reference="${name}">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <self_collide>true</self_collide>
      <gravity>true</gravity>
    </gazebo>
  </xacro:macro>

  <!-- Loads gz_ros2_control and the controller_manager parameters. -->
  <xacro:macro name="gz_ros2_control_plugin" params="controllers_file">
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${controllers_file}</parameters>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
